# SG-IA unified deployment. Copy this file to .env and keep .env private.

# A local JSON credential file mounted read-only into both backends.
# Never commit a populated credential file.
SGIA_AWS_CREDENTIALS_FILE=./WIKI/aws_credentials.example.json
AWS_REGION=eu-central-1

# Alternatively provide temporary AWS environment credentials here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Host ports
RAG_API_PORT=8001
RAG_UI_PORT=8502
RAG_QDRANT_PORT=6337
RAG_QDRANT_GRPC_PORT=6338
WIKI_API_PORT=8002
WIKI_UI_PORT=8503
COMPARISON_UI_PORT=8504

# Optional model overrides; blank values use the tracked component registries.
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=
BEDROCK_EMBEDDING_DIMENSIONS=
BEDROCK_GENERATION_MODEL_ID=
BEDROCK_CONFIDENCE_MODEL_ID=

# Retrieval and answer verification
RAG_CHAT_TOP_K=10
RAG_CHAT_CANDIDATE_POOL_SIZE=24
RAG_CHAT_NEIGHBOR_WINDOW=1
RAG_CHAT_COVERAGE_RETRY_ENABLED=true
RAG_CHAT_COVERAGE_MIN_RATIO=0.8
RAG_CHAT_MAX_RETRIEVAL_ATTEMPTS=2
RAG_CONFIDENCE_ENABLED=true
LLM_WIKI_SEMANTIC_SEARCH_ENABLED=true
LLM_WIKI_ANSWER_GUARDRAIL_ENABLED=false
COMPARISON_CHAT_TIMEOUT_SECONDS=660
