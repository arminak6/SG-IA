# Host ports. They intentionally differ from the RAG stack.
WIKI_API_PORT=8002
WIKI_UI_PORT=8503

# Use the existing ignored JSON configuration by changing this to:
# WIKI_AWS_CREDENTIALS_FILE=./aws_credentials.json
WIKI_AWS_CREDENTIALS_FILE=./aws_credentials.example.json

# Environment values take precedence over the JSON file when provided.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=512
LLM_WIKI_SEMANTIC_SEARCH_ENABLED=true

