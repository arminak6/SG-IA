# Host port for the comparison Streamlit application.
COMPARISON_UI_PORT=8504

# From inside this container, the independent RAG and WIKI stacks are reached
# through their host-published API ports.
RAG_API_URL=http://host.docker.internal:8001
WIKI_API_URL=http://host.docker.internal:8002

# Bedrock-backed answers can take several minutes for large evidence contexts.
COMPARISON_CHAT_TIMEOUT_SECONDS=660
