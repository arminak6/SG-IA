{
  "schema_version": 1,
  "extraction": {
    "engine": "docling",
    "layout_model_id": "docling-default-layout",
    "ocr_model_id": "rapidocr-pp-ocrv6",
    "table_structure_model_id": "tableformer-accurate",
    "ocr_enabled": true
  },
  "embedding": {
    "provider": "amazon-bedrock",
    "model_id": "amazon.titan-embed-text-v2:0",
    "dimensions": 512,
    "normalize": true
  },
  "generation": {
    "provider": "amazon-bedrock",
    "api": "converse",
    "model_id": "openai.gpt-oss-20b-1:0",
    "temperature": 0.1,
    "max_output_tokens": 1800
  }
}
