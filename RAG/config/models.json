{
  "schema_version": 1,
  "pipeline_version": "1.2",
  "extraction": {
    "engine": "docling",
    "layout_model_id": "docling-default-layout",
    "ocr_model_id": "rapidocr-pp-ocrv6",
    "table_structure_model_id": "tableformer-accurate",
    "ocr_enabled": true
  },
  "embedding": {
    "provider": "amazon-bedrock",
    "model_id": "amazon.titan-embed-text-v2:0",
    "dimensions": 512,
    "normalize": true
  },
  "chunking": {
    "strategy": "structure-aware",
    "max_tokens": 600,
    "overlap_tokens": 100
  },
  "retrieval": {
    "strategy": "semantic-candidate-neighbor-rerank-coverage-v1.2",
    "candidate_pool_size": 24,
    "final_top_k": 10,
    "neighbor_window": 1,
    "coverage_retry_enabled": true,
    "coverage_min_ratio": 0.8,
    "max_attempts": 2
  },
  "generation": {
    "provider": "amazon-bedrock",
    "api": "converse",
    "model_id": "openai.gpt-oss-20b-1:0",
    "temperature": 0.1,
    "max_output_tokens": 1800
  }
}
