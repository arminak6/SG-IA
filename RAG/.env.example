# Host ports
RAG_API_PORT=8001
RAG_UI_PORT=8502
RAG_QDRANT_PORT=6337
RAG_QDRANT_GRPC_PORT=6338

# AWS Bedrock. Prefer a temporary profile or temporary environment credentials.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Retrieval configuration. Change the collection name if model dimensions change.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=512
QDRANT_COLLECTION=sgia_rag_chunks_titan_v2_512
RAG_CHUNK_MAX_TOKENS=600
RAG_CHUNK_OVERLAP_TOKENS=60
RAG_MAX_UPLOAD_BYTES=104857600
DOCLING_DO_OCR=true

