# Host ports
RAG_API_PORT=8001
RAG_UI_PORT=8502
RAG_QDRANT_PORT=6337
RAG_QDRANT_GRPC_PORT=6338

# AWS Bedrock. Prefer a temporary profile or temporary environment credentials.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional alternative to AWS_* values: mount a local JSON credentials file
# read-only and tell the backend where it appears inside the container.
RAG_AWS_CREDENTIALS_HOST_FILE=./aws_credentials.example.json
RAG_AWS_CREDENTIALS_FILE=

# Optional model overrides. Leave blank to use config/models.json.
BEDROCK_EMBEDDING_MODEL_ID=
BEDROCK_EMBEDDING_DIMENSIONS=
BEDROCK_GENERATION_MODEL_ID=
RAG_GENERATION_TEMPERATURE=
RAG_GENERATION_MAX_OUTPUT_TOKENS=

# Retrieval configuration. Change the collection name if embedding dimensions change.
RAG_CHAT_TOP_K=10
RAG_CHAT_CANDIDATE_POOL_SIZE=24
RAG_CHAT_NEIGHBOR_WINDOW=1
RAG_CHAT_COVERAGE_RETRY_ENABLED=true
RAG_CHAT_COVERAGE_MIN_RATIO=0.8
RAG_CHAT_MAX_RETRIEVAL_ATTEMPTS=2
RAG_CHAT_MAX_CONTEXT_CHARACTERS=60000
QDRANT_COLLECTION=sgia_rag_chunks_titan_v2_512
RAG_CHUNK_MAX_TOKENS=600
RAG_CHUNK_OVERLAP_TOKENS=100
RAG_MAX_UPLOAD_BYTES=104857600
DOCLING_DO_OCR=
